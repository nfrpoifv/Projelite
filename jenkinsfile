pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Deploy Docker') {
            steps {
                bat """
                docker-compose build
                docker-compose up -d
                """
            }
        }
    }

    post {
        success {
            echo 'All containers are up and running!'
        }
        failure {
            echo 'Deployment failed!'
        }
    }
}